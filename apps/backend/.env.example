DATABASE_URL="postgresql://oplata:oplata_dev_password@localhost:5432/oplata?schema=public"
JWT_SECRET="change_me_in_production"
JWT_EXPIRES_IN="8h"
PORT=3001

# Ключ доступа владельца платформы (панель /platform) — придумайте длинную случайную строку.
PLATFORM_ADMIN_KEY="change_me_in_production"

# Адрес сайта (фронтенда) — в письмах ссылки ведут сюда.
APP_URL="http://localhost:5173"

# Откуда разрешены запросы к API (через запятую). Не задано — только наш сайт и localhost.
# CORS_ORIGINS="https://paymentsmall.netlify.app"

# Отправка писем (SMTP). Без этих настроек письма не уходят (ссылка печатается в консоль сервера).
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_USER="you@gmail.com"
# SMTP_PASS="пароль-приложения"
# MAIL_FROM="Оплата <you@gmail.com>"
# Только для локального компьютера, если антивирус ломает защищённое соединение
# (ошибка «self-signed certificate in certificate chain»). На боевом сервере не включать.
# SMTP_TLS_INSECURE=true
