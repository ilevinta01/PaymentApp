generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  TEACHER
}

enum PaymentMethod {
  CASH
  CARD
}

enum StudentStatus {
  ACTIVE
  SICK
  VACATION
  PAUSE
}

enum SubscriptionStatus {
  ACTIVE
  BLOCKED
}

model Tenant {
  id                     String              @id @default(uuid())
  name                   String
  subscriptionStatus     SubscriptionStatus  @default(ACTIVE)
  subscriptionPaidUntil  DateTime
  contractFileUrl        String?
  contractUploadedAt     DateTime?
  createdAt              DateTime            @default(now())

  settings        TenantSettings?
  users           User[]
  groups          Group[]
  students        Student[]
  payments          Payment[]
  paymentLogs       PaymentLog[]
  cashCollections   CashCollection[]
  individualLessons IndividualLesson[]
  rooms             Room[]
  individualLessonLogs IndividualLessonLog[]
  balanceTransactions  BalanceTransaction[]
}

// Физический зал/класс школы. allowDoubleBooking управляет строгостью проверки пересечений:
// true (по умолчанию) — система лишь предупреждает о пересечении, решение за пользователем;
// false — админ явно запретил занимать зал одновременно, тогда пересечение блокируется.
model Room {
  id                 String   @id @default(uuid())
  tenantId           String
  tenant             Tenant   @relation(fields: [tenantId], references: [id])
  name               String
  allowDoubleBooking Boolean  @default(true)
  // Часы работы зала — используются как границы сетки в расписании (визуально показываем
  // только это окно); задаются при создании, администратор может их менять позже.
  workingHoursStart  String   @default("09:00")
  workingHoursEnd    String   @default("21:00")
  createdAt          DateTime @default(now())

  scheduleSlots     GroupScheduleSlot[]
  individualLessons IndividualLesson[]

  @@index([tenantId])
}

model TenantSettings {
  tenantId                 String  @id
  tenant                   Tenant  @relation(fields: [tenantId], references: [id])
  isCardEnabled            Boolean @default(false)
  isTelegramEnabled        Boolean @default(false)
  isCashCollectionEnabled  Boolean @default(false)
  isTeacherEarningsEnabled Boolean @default(false)
  isIndividualLessonsEnabled Boolean @default(false)
  isScheduleEnabled        Boolean @default(false)
  isPaymentsReportEnabled  Boolean @default(false)
  isDebtorsReportEnabled   Boolean @default(false)
  isIndividualDebtorsReportEnabled Boolean @default(false)
  isChangeLogEnabled       Boolean @default(false)
  telegramBotToken         String?
  primaryColor             String?
  logoUrl                  String?
  // Единый цвет всех индивидуальных занятий в расписании (у групп цвет свой у каждой,
  // см. Group.color) — задаётся администратором тенанта в настройках.
  individualLessonColor    String  @default("#f59e0b")
}

// Глобальный (не привязанный к тенанту) прайс-лист платных функций — задаётся владельцем
// платформы во вкладке «Тарифы» и используется как справочная цена во вкладке «Функции системы».
model FeaturePrice {
  key   String  @id
  price Decimal @default(0) @db.Decimal(10, 2)
}

// email уникален глобально по платформе (не в рамках тенанта), т.к. на экране логина
// пользователь вводит только email+пароль без выбора тенанта.
model User {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  email        String   @unique
  passwordHash String
  role         Role
  fullName     String
  phone        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Ставка за час индивидуального занятия — задаётся Супер-Админом персонально
  // для каждого преподавателя, у разных преподавателей ставка может отличаться.
  individualLessonRate Decimal? @db.Decimal(10, 2)
  // Telegram-чат самого преподавателя (не путать с parentTelegramChatId у ученика) —
  // используется для уведомлений о новых/изменённых индивидуальных занятиях.
  telegramChatId       String?

  groupsTaught          Group[]              @relation("GroupTeachers")
  paymentsCreated       Payment[]            @relation("PaymentCreatedBy")
  paymentLogsEdited     PaymentLog[]         @relation("PaymentLogEditedBy")
  cashCollectedFrom     CashCollection[]     @relation("CashCollectedFromTeacher")
  cashCollectedBy       CashCollection[]     @relation("CashCollectedByAdmin")
  individualLessons     IndividualLesson[]   @relation("IndividualLessonTeacher")
  individualLessonsMade IndividualLesson[]   @relation("IndividualLessonCreatedBy")
  individualLessonLogsActedBy IndividualLessonLog[] @relation("IndividualLessonLogActor")
  balanceTransactionsCreated  BalanceTransaction[]  @relation("BalanceTransactionCreatedBy")

  @@index([tenantId])
}

model Group {
  id           String   @id @default(uuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id])
  name         String
  monthlyPrice Decimal  @db.Decimal(10, 2)
  // Цвет группы в расписании — задаётся администратором, чтобы визуально отличать группы.
  color        String   @default("#6366f1")
  createdAt    DateTime @default(now())

  // Группу может вести несколько преподавателей одновременно; Супер-Админ
  // имеет доступ ко всем группам тенанта независимо от этой связи.
  teachers      User[]              @relation("GroupTeachers")
  students      Student[]
  scheduleSlots GroupScheduleSlot[]

  @@index([tenantId])
}

// Еженедельно повторяющийся слот занятия группы (например, "Пн 15:00-16:00").
// dayOfWeek: 0 = воскресенье .. 6 = суббота (как Date.getDay() в JS).
// startMinutes/endMinutes — минуты от полуночи, чтобы легко сравнивать пересечения.
model GroupScheduleSlot {
  id           String  @id @default(uuid())
  groupId      String
  group        Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  dayOfWeek    Int
  startMinutes Int
  endMinutes   Int
  roomId       String?
  room         Room?   @relation(fields: [roomId], references: [id])

  @@index([groupId])
  @@index([roomId])
}

model Student {
  id                   String         @id @default(uuid())
  tenantId             String
  tenant               Tenant         @relation(fields: [tenantId], references: [id])
  groupId              String
  group                Group          @relation(fields: [groupId], references: [id])
  fullName             String
  dateOfBirth          DateTime?
  phone                String?
  parentFullName       String?
  parentPhone          String?
  parentTelegramChatId String?
  status               StudentStatus  @default(ACTIVE)
  statusUntil          DateTime?
  createdAt            DateTime       @default(now())

  // Аванс/баланс ученика: пополняется вручную (например, оплата за несколько месяцев вперёд)
  // и автоматически списывается в счёт будущих месяцев группы и/или индивидуальных занятий.
  balance Decimal @default(0) @db.Decimal(10, 2)

  payments               Payment[]
  individualLessonShares IndividualLessonParticipant[]
  balanceTransactions    BalanceTransaction[]

  @@index([tenantId])
  @@index([groupId])
}

model Payment {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  createdById   String
  createdBy     User          @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  dateTime      DateTime      @default(now())
  periodMonth   String
  // true — этот платёж не новые деньги, а автоматическое списание с баланса (аванса)
  // ученика за этот месяц; исключается из сумм "собрано" в отчётах, чтобы не задваивать
  // выручку (деньги уже были учтены в момент пополнения баланса).
  fundedFromBalance Boolean @default(false)

  logs PaymentLog[]

  @@index([tenantId])
  @@index([studentId])
  @@index([tenantId, periodMonth])
}

// Инкассация: фиксация факта изъятия наличных у преподавателя Супер-Админом,
// чтобы можно было свести баланс "накопленной" наличности у каждого преподавателя.
model CashCollection {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  teacherId     String
  teacher       User     @relation("CashCollectedFromTeacher", fields: [teacherId], references: [id])
  amount        Decimal  @db.Decimal(10, 2)
  collectedById String
  collectedBy   User     @relation("CashCollectedByAdmin", fields: [collectedById], references: [id])
  collectedAt   DateTime @default(now())

  @@index([tenantId])
  @@index([teacherId])
}

// Индивидуальное занятие: один преподаватель, одна дата/время, один или несколько учеников.
// Итоговая стоимость = ставка преподавателя (зафиксированная на момент создания) × часы,
// делится поровну между участниками — см. IndividualLessonParticipant.
model IndividualLesson {
  id                String   @id @default(uuid())
  tenantId          String
  tenant            Tenant   @relation(fields: [tenantId], references: [id])
  teacherId         String
  teacher           User     @relation("IndividualLessonTeacher", fields: [teacherId], references: [id])
  startAt           DateTime
  durationMinutes   Int
  hourlyRateSnapshot Decimal @db.Decimal(10, 2)
  totalPrice        Decimal  @db.Decimal(10, 2)
  createdById       String
  createdBy         User     @relation("IndividualLessonCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime @default(now())
  roomId            String?
  room              Room?    @relation(fields: [roomId], references: [id])
  // Необязательное произвольное описание типа занятия (математика, латино, балет и т.п.),
  // вводится вручную преподавателем/админом при создании.
  subject           String?

  participants IndividualLessonParticipant[]

  @@index([tenantId])
  @@index([teacherId])
  @@index([roomId])
}

model IndividualLessonParticipant {
  id                 String           @id @default(uuid())
  individualLessonId String
  individualLesson   IndividualLesson @relation(fields: [individualLessonId], references: [id])
  studentId          String
  student            Student          @relation(fields: [studentId], references: [id])
  shareAmount        Decimal          @db.Decimal(10, 2)
  isPaid             Boolean          @default(false)
  paymentMethod      PaymentMethod?
  paidAt             DateTime?
  // Оплачено списанием с баланса (аванса) ученика, а не наличными/картой в моменте —
  // исключается из "заработано" в отчётах по преподавателям, чтобы не задваивать выручку.
  paidFromBalance    Boolean          @default(false)

  @@index([individualLessonId])
  @@index([studentId])
}

model PaymentLog {
  id         String        @id @default(uuid())
  tenantId   String
  tenant     Tenant        @relation(fields: [tenantId], references: [id])
  paymentId  String
  payment    Payment       @relation(fields: [paymentId], references: [id])
  editDate   DateTime      @default(now())
  oldAmount  Decimal       @db.Decimal(10, 2)
  newAmount  Decimal       @db.Decimal(10, 2)
  oldMethod  PaymentMethod
  newMethod  PaymentMethod
  reason     String
  editedById String
  editedBy   User          @relation("PaymentLogEditedBy", fields: [editedById], references: [id])

  @@index([tenantId])
  @@index([paymentId])
}

// Реестр операций по индивидуальным занятиям для "Реестра изменений" — храним снимок данных
// (имена, а не только id), т.к. само занятие при отмене удаляется и связь потерялась бы.
// action: "CANCELLED" | "PARTICIPANT_PAID" (обычная строка, не enum — чтобы не тянуть тип
// из Prisma в shared-пакет, где уже есть похожий гоча с номинальной типизацией enum'ов).
model IndividualLessonLog {
  id            String   @id @default(uuid())
  tenantId      String
  tenant        Tenant   @relation(fields: [tenantId], references: [id])
  action        String
  actorId       String
  actor         User     @relation("IndividualLessonLogActor", fields: [actorId], references: [id])
  teacherName   String
  studentNames  String
  lessonStartAt DateTime
  amount        Decimal? @db.Decimal(10, 2)
  details       String?
  createdAt     DateTime @default(now())

  @@index([tenantId])
}

// История операций с балансом (авансом) ученика — пополнения и автоматические/ручные
// списания в счёт группы или индивидуального занятия. kind: "DEPOSIT" | "GROUP_CONSUMPTION" |
// "INDIVIDUAL_CONSUMPTION" (строка, не enum — см. комментарий у IndividualLessonLog выше).
model BalanceTransaction {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  studentId     String
  student       Student       @relation(fields: [studentId], references: [id])
  amount        Decimal       @db.Decimal(10, 2)
  kind          String
  paymentMethod PaymentMethod?
  note          String?
  createdById   String
  createdBy     User          @relation("BalanceTransactionCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())

  @@index([tenantId])
  @@index([studentId])
}
